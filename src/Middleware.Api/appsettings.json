{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App.db"
  },
  "Eis": {
    "BaseUrl": "https://eis.bir.gov.ph",
    "AuthPath": "/api/auth",
    "SubmitPath": "/api/invoices",
    "ResultPath": "/api/invoices/result",
    "CertificationNumber": "ABCD1234",
    "ApplicationId": "APP-000000",
    "HttpTimeout": "00:00:30",
    "TokenRefreshMargin": "00:10:00",
    "MaxBatchSize": 100
  },
  "TransmissionWorker": { "Interval": "00:01:00", "MaxAttempts": 10, "BaseRetryDelay": "00:02:00" },
  "ResultPoller": { "Interval": "00:05:00" },
  "Compliance": { "UnsentAlertThreshold": "2.00:00:00", "DailyRunTime": "02:00:00" }
}
